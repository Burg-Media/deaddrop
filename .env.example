# Deaddrop node-configuratie. Kopieer naar .env en vul in.
# De app weigert te starten zolang APP_URL, APP_KEY of de database-instellingen ontbreken.

APP_NAME=Deaddrop

# Waar gebruikers de broncode vinden (AGPL-3.0). Draai je een aangepaste versie,
# zet hier dan de plek waar jouw wijzigingen staan.
APP_SOURCE_URL=https://github.com/Burg-Media/deaddrop

# Exact de URL waarmee de browser de app opent, zonder slash aan het eind.
# Web Crypto werkt alleen via HTTPS (of localhost).
APP_URL=https://deaddrop.example.org
APP_COOKIE_SECURE=true

# Minimaal 32 tekens, stabiel houden tussen deploys. Maak er een met:
#   php tools/generate_app_key.php
APP_KEY=

# Pas op true zetten als er een admin-device geactiveerd is (zie docs/install.md).
APP_DEVICE_TRUST_REQUIRED=false
APP_DEVICE_COOKIE_NAME=dd_device
NODE_ADMIN_ACTION_KEY_HASH=

# Sessies: inactief na N minuten uitloggen, en hoe dan ook na N uur.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=deaddrop
DB_USERNAME=deaddrop
DB_PASSWORD=

MAX_EXPIRY_MINUTES=10080
DEFAULT_EXPIRY_MINUTES=1440
